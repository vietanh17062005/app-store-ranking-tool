NODE_ENV=development
PORT=3000
TIMEZONE=Asia/Ho_Chi_Minh
CRON_SCHEDULE=0 12 * * *
API_TOKEN=
CMS_APPS_URL=https://cms-api.abc-elearning.org/api/app/config/summary
COUNTRIES=VN,US,CA,AU,GB,IN,MY
RANKING_DEPTH=200
ENABLE_GOOGLE_PLAY=true
ENABLE_APP_STORE=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=xep_hang_app
DB_USER=root
DB_PASSWORD=
DB_SSL=false
DB_CONNECTION_LIMIT=10

RANKING_MODE=live
RANKING_GOOGLE_PLAY_SOURCE=browser
RANKING_BROWSER=chrome
RANKING_BROWSER_HEADLESS=false
RANKING_PROXY_MODE=off

# API tích hợp /api/v1: token (Bearer hoặc X-API-Key) và giới hạn số lượt kiểm tra mỗi yêu cầu
API_MAX_CHECKS=200
